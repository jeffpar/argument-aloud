  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Home",
      "url": "http://localhost:4010",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "USSC",
      "url": "http://localhost:4010/courts/ussc",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "USSC 2006 Term: Parents Involved in Community Schools v. Seattle School District No. 1",
      "url": "http://localhost:4010/courts/ussc/?term=2006-10&case=05-908&event=5",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "USSC 2014 Term: McFadden v. United States",
      "url": "http://localhost:4010/courts/ussc/?term=2014-10&case=14-378",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "USSC 2025 Term: Watson v. RNC",
      "url": "http://localhost:4010/courts/ussc/?term=2025-10&case=24-1260",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
