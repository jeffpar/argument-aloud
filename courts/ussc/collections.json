  {
    "name": "Historical",
    "collections": [
      {
        "name": "Briefs",
        "file": "/courts/ussc/collections/briefs.json",
        "search": "cases:title",
        "order": "argument:ascending",
        "groups": [
          {
            "name": "Briefs ($first_decision_year-$last_decision_year)",
            "tags": ["Historical Briefs"]
          }
        ]
      },
      {
        "name": "Media Files",
        "file": "/courts/ussc/collections/media.json",
        "page": "/courts/ussc/collections/media",
        "groups": [
          {
            "name": "Audio Files",
            "conditions": [
              "COUNT(file.type == 'mp3') > 0"
            ],
            "order": "decision:ascending"
          },
          {
            "name": "Video Files",
            "conditions": [
              "COUNT(file.type == 'mp4') > 0"
            ],
            "order": "decision:ascending"
          }
        ],
        "search": "cases:title"
      },
      {
        "name": "Original Jurisdiction",
        "file": "/courts/ussc/collections/orig.json",
        "page": "/courts/ussc/collections/orig",
        "scrollToPage": true,
        "groups": [
          {
            "name": "Archive",
            "tags": ["Original Jurisdiction Archive"]
          }
        ],
        "search": "cases:title"
      },
      {
        "name": "Top Cites",
        "file": "/courts/ussc/collections/top_cites.json",
        "search": "name",
        "scrollLabel": "opinions"
      },
      {
        "name": "Transcripts",
        "file": "/courts/ussc/collections/transcripts.json",
        "search": "cases:title",
        "order": "argument:ascending",
        "groups": [
          {
            "name": "Transcripts ($first_decision_year-$last_decision_year)",
            "tags": ["Historical Transcripts"]
          }
        ]
      }
    ]
  },
