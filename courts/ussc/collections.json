  {
    "name": "Media Files Cited",
    "file": "/courts/ussc/collections/media.json",
    "link": "/courts/ussc/collections/media",
    "groups": [
      {
        "name": "Audio Files",
        "conditions": [
          "COUNT(file.type == 'mp3') > 0"
        ],
        "order": "decided:ascending"
      },
      {
        "name": "Video Files",
        "conditions": [
          "COUNT(file.type == 'mp4') > 0"
        ],
        "order": "decided:ascending"
      }
    ],
    "search": "cases:title"
  },
  {
    "name": "Original Jurisdiction",
    "file": "/courts/ussc/collections/orig.json",
    "link": "/courts/ussc/collections/orig",
    "groups": [
      {
        "name": "Archive",
        "tags": ["Original Jurisdiction Archive"]
      }
    ]
  },
  {
    "name": "Outstanding Issues",
    "file": "/courts/ussc/collections/issues.json",
    "groups": [
      {
        "name": "Cases Missing Audio",
        "conditions": [
          "argument >= '1955-10-01'",
          "COUNT(event.audio_href) == 0"
        ],
        "order": "argued:ascending"
      },
      {
        "name": "Cases with Unaligned Audio",
        "conditions": [
          "event.source == 'oyez' && event.audio_href && !event.aligned"
        ],
        "order": "argued:ascending"
      },
      {
        "name": "Cases with Unidentified Speakers",
        "conditions": [
          "event.source == 'oyez' && COUNT(event.text_href.turn.name contains 'UNKNOWN') >= 100"
        ],
        "order": "argued:ascending",
        "link": "/courts/ussc/transcripts/updates"
      },
      {
        "name": "Cases Missing from SCDB",
        "conditions": [
          "term <= '2024-10'",
          "id == undefined"
        ],
        "order": "decided:ascending"
      }
    ],
    "search": "cases:title"
  },
