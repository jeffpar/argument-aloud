  {
    "name": "Outstanding Issues",
    "file": "/courts/ussc/collections/issues.json",
    "groups": [
      {
        "name": "Cases Missing Audio",
        "conditions": [
          "argument >= '1955-10-01'",
          "COUNT(event.audio_href) == 0"
        ],
        "order": "argument:ascending,titles:ascending"
      },
      {
        "name": "Cases with Unaligned Audio",
        "conditions": [
          "event.source == 'oyez' && event.audio_href && !event.aligned"
        ],
        "order": "argument:ascending,titles:ascending"
      },
      {
        "name": "Cases with Unidentified Speakers",
        "conditions": [
          "event.source == 'oyez' && COUNT(event.text_href.turn.name contains 'UNKNOWN') >= 100"
        ],
        "order": "argument:ascending,titles:ascending",
        "page": "/courts/ussc/transcripts/updates"
      },
      {
        "name": "Cases with Opinion Transcripts",
        "conditions": [
          "event.source == 'ussc' && event.type == 'opinion'"
        ],
        "order": "decision:ascending,titles:ascending",
        "page": "/courts/ussc/transcripts/opinions"
      },
      {
        "name": "Cases Without LOC Opinion",
        "conditions": [
          "volume <= 578",
          "decision_loc == undefined"
        ],
        "order": "decision:ascending,titles:ascending"
      },
      {
        "name": "Cases Without XML Opinion",
        "conditions": [
          "volume <= 609",
          "decision_xml == undefined"
        ],
        "order": "decision:ascending,titles:ascending"
      },
      {
        "name": "Cases Without SCDB Record",
        "conditions": [
          "term <= '2024-10'",
          "id == undefined"
        ],
        "order": "decision:ascending,titles:ascending"
      }
    ],
    "search": "cases:title"
  }
]
