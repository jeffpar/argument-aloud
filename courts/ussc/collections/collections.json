  {
    "name": "Audits",
    "file": "/courts/ussc/collections/audits/audits.json",
    "page": "/courts/ussc/collections/audits",
    "groups": [
      {
        "id": "missing-audio",
        "name": "Cases Missing Audio",
        "conditions": [
          "argument >= '1955-10-01'",
          "COUNT(event.audio_href) == 0"
        ],
        "order": "argument:ascending,titles:ascending"
      },
      {
        "id": "unaligned-audio",
        "name": "Cases with Unaligned Audio",
        "conditions": [
          "event.source == 'oyez' && event.audio_href && !event.aligned"
        ],
        "order": "argument:ascending,titles:ascending"
      },
      {
        "id": "unidentified-speakers",
        "name": "Cases with Unidentified Speakers",
        "conditions": [
          "event.source == 'oyez' && COUNT(event.text_href.turn.name contains 'UNKNOWN') >= 100"
        ],
        "order": "argument:ascending,titles:ascending",
        "page": "/courts/ussc/transcripts/updates"
      },
      {
        "id": "missing-loc-opinion",
        "name": "Cases Missing LOC Opinion",
        "conditions": [
          "volume <= 578",
          "decision_loc == undefined"
        ],
        "order": "decision:ascending,titles:ascending"
      },
      {
        "id": "missing-xml-opinion",
        "name": "Cases Missing XML Opinion",
        "conditions": [
          "volume <= 609",
          "decision_xml == undefined"
        ],
        "order": "decision:ascending,titles:ascending"
      },
      {
        "id": "missing-scdb-records",
        "name": "Cases Missing SCDB Records",
        "conditions": [
          "term <= '2024-10'",
          "id == undefined"
        ],
        "order": "decision:ascending,titles:ascending"
      },
      {
        "id": "incorrect-scdb-records",
        "name": "Cases with Incorrect SCDB Records",
        "conditions": [
          [
            "scdb_check contains 'argument'",
            "!argument contains ','"
          ],
          [
            "scdb_check contains 'reargument'",
            "!reargument contains ','"
          ],
          [
            "scdb_check contains 'decision'"
          ]
        ],
        "order": "decision:ascending,titles:ascending"
      },
      {
        "id": "all-warnings",
        "name": "Cases with Warnings",
        "page": "/courts/ussc/collections/audits/warnings",
        "conditions": [
          [
            "scdb_message != undefined"
          ],
          [
            "audit_message != undefined"
          ]
        ],
        "fields": ["scdb_message", "audit_message"],
        "order": "decision:ascending,titles:ascending"
      },
      {
        "id": "minutes-links",
        "name": "Cases Linked to Minutes",
        "conditions": [
          "event.minutes_src",
          "audit_message != undefined"
        ],
        "order": "argument:ascending,titles:ascending",
        "openFile": "event.date",
        "enabled": false
      },
      {
        "id": "incorrect-scdb-data",
        "name": "Cases with Other Incorrect SCDB Data",
        "conditions": [
          "scdb_check != undefined",
          "!scdb_check contains 'argument'",
          "!scdb_check contains 'reargument'",
          "!scdb_check contains 'decision'"
        ],
        "order": "decision:ascending,titles:ascending",
        "enabled": false
      },
      {
        "id": "ignored-scdb-records",
        "name": "Cases Not Included from SCDB",
        "page": "/courts/ussc/collections/scdb",
        "enabled": false
      }
    ],
    "search": "cases:title"
  }
]
