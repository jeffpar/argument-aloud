        "groups": [
          {
            "name": "Opinions",
            "page": "/courts/ussc/collections/oddities/transcripts",
            "conditions": [
              "event.source == 'ussc' && event.type == 'opinion'"
            ],
            "order": "decision:ascending,titles:ascending"
